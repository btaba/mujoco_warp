<mujoco model="panda scene with trashbag (vanilla flex)">
  <include file="panda.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <option timestep="0.002" integrator="implicitfast" solver="CG" tolerance="1e-5" iterations="1000">
    <flag eulerdamp="disable"/>
  </option>

  <size njmax="5000" nconmax="4000"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
    <scale contactwidth="0.075" contactheight="0.025" forcewidth="0.05" com="0.05" framewidth="0.01" framelength="0.2"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <camera name="front" pos="1.4 0 0.6" fovy="58" mode="fixed" euler="0 1.2 1.5708"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1"/>

    <!-- Deformable garbage bag mesh simulated natively by MuJoCo's soft-body solver -->
    <!-- Configured with high tensile stiffness (young=2.5e5) to represent tough plastic -->
    <flexcomp type="mesh" file="Trashbag_coarse.obj" pos="0.62 -0.35 0.25" dim="2" euler="0 0 45"
              radius="0.002" rgba="0.15 0.15 0.15 1" mass="0.15" name="trashbag">
      <elasticity young="2.5e5" poisson="0.3" damping="0.05"/>
      <contact selfcollide="none" internal="true" contype="1" conaffinity="1"/>
    </flexcomp>
  </worldbody>
</mujoco>
