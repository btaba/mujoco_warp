<mujoco model="panda scene with trashbag (coupled IPC)">
  <include file="panda.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <option timestep="0.001" integrator="implicitfast" solver="CG" tolerance="1e-3" gravity="0 0 0">
    <flag eulerdamp="disable" nativeccd="disable"/>
  </option>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <camera name="front" pos="1.4 0 0.6" fovy="58" mode="fixed" euler="0 1.2 1.5708"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1"/>

    <!-- Deformable garbage bag mesh with MuJoCo contacts and physics disabled -->
    <!-- driven entirely by the high-fidelity IPC solver coupling -->
    <flexcomp type="mesh" file="Trashbag_coarse.obj" pos="0.62 -0.35 0.25" dim="2" euler="0 0 45"
              radius="0.002" rgba="0.15 0.15 0.15 1" mass="0.15" name="trashbag">
      <elasticity young="1.5e4" poisson="0.45" damping="0.001"/>
      <contact selfcollide="none" internal="false" contype="0" conaffinity="0"/>
    </flexcomp>
  </worldbody>
</mujoco>
